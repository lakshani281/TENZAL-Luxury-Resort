# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Connection Configuration (Placeholder — Do not commit real credentials)
# Unified / Room Booking & User Management (backend/config/db.js) + Food Ordering (backend/src/config/db.js)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tenzal_resort
DB_USER=postgres
DB_PASSWORD=your_password
# Optional connection string & SSL override (used by Food Ordering backend/src/config/db.js)
# DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<database>?sslmode=require
# DB_SSL=false

# Authentication & Security (User Management Module | 22CIS0274)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
